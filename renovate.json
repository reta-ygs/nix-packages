{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "pinDigest", "digest", "bump", "rollback", "replacement", "lockfileUpdate"],
      "enabled": false
    }
  ],
  "nix": { "enabled": true }
}
